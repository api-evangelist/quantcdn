                "value": "test-org",
                "type": "path",
                "description": "The organisation ID"
              },
              {
                "name": "application",
                "value": "test-app",
                "type": "path",
                "description": "The application ID"
              },
              {
                "name": "environment",
                "value": "test-env",
                "type": "path",
                "description": "The environment ID"
              },
              {
                "name": "startTime",
                "value": "",
