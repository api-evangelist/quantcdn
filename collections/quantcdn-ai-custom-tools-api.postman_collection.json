        {
          "id": "d3fa6fff-14e0-45af-8410-0f109e678179",
          "name": "Register Custom Edge Function Tool",
          "request": {
            "name": "Register Custom Edge Function Tool",
            "description": {
              "content": "Registers a custom edge function as a tool that AI models can invoke. Provide `edgeFunctionCode` (JavaScript) and the API will deploy it to the CDN, compute the edge function URL, and register the tool.\n     *\n     * **Edge Function Contract:**\n     * - Edge functions must accept POST requests with JSON payload\n     * - Expected request format: `{ 'toolName': '...', 'input': {...}, 'orgId': '...' }`\n     * - Must return JSON response with either `result` or `error` field\n     *\n     * **Idempotent Updates:**\n     * POSTing with the same `name` will update the existing tool — the edge function code is redeployed to the same UUID and the tool registration is updated.\n     *\n     * **Async Tools:**\n     * Set `isAsync: true` for operations >5 seconds. The edge function should return `{ executionId: '...' }` and the AI will poll for completion.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "organizations",
                ":organisation",
                "ai",
                "custom-tools"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "organisation",
                  "description": "(Required) The organisation ID"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"<string>\",\n  \"edgeFunctionCode\": \"<string>\",\n  \"inputSchema\": \"<object>\",\n  \"name\": \"<string>\",\n  \"isAsync\": false,\n  \"timeoutSeconds\": 30,\n  \"outputSchema\": \"<object>\",\n  \"outputSchemaDescription\": \"<string>\",\n  \"category\": \"<string>\",\n  \"responseMode\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
