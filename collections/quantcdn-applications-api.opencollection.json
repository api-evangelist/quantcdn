{
  "opencollection": "1.0.0",
  "info": {
    "name": "QuantCDN AI Agents Applications API",
    "version": "4.15.8"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Applications",
