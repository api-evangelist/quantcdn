        {
          "id": "b0ab9d66-9cfc-4d50-8603-1a442c076452",
          "name": "Get AI Model Details",
          "request": {
            "name": "Get AI Model Details",
            "description": {
              "content": "Retrieves detailed information about a specific Bedrock model from the catalog.\n     *\n     * **Features:**\n     * - Complete pricing breakdown (input/output per million tokens)\n     * - Context window and output token limits\n     * - Supported features (chat, vision, streaming, embeddings)\n     * - Model availability and deprecation status\n     * - Release date for version tracking\n     *\n     * **Example Model IDs:**\n     * - `amazon.nova-lite-v1:0` - Default multimodal model\n     * - `anthropic.claude-3-5-sonnet-20241022-v2:0` - Latest Claude\n     * - `amazon.titan-embed-text-v2:0` - Latest embeddings",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "organizations",
                ":organisation",
                "ai",
                "models",
                ":modelId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "organisation",
                  "description": "(Required) The organisation ID"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "modelId",
                  "description": "(Required) The model identifier (e.g., amazon.nova-lite-v1:0)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "775b654f-8914-4c85-9e8d-20a3c9310144",
              "name": "Model details retrieved successfully",
