{
  "opencollection": "1.0.0",
  "info": {
    "name": "QuantCDN AI Agents SSH Access API",
    "version": "4.15.8"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "SSH Access",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get SSH access credentials for an environment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dashboard.quantcdn.io/api/v3/organizations/:organisation/applications/:application/environments/:environment/ssh-access",
            "params": [
              {
                "name": "organisation",
                "value": "test-org",
                "type": "path",
                "description": "The organisation ID"
              },
              {
                "name": "application",
                "value": "test-app",
                "type": "path",
                "description": "The application ID"
              },
              {
                "name": "environment",
                "value": "test-env",
                "type": "path",
                "description": "The environment ID"
              }
            ]
          },
          "docs": "Get SSH access credentials for an environment"
        }
      ]
    }
  ],
  "bundled": true
}