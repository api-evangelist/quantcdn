{
  "opencollection": "1.0.0",
  "info": {
    "name": "QuantCDN AI Agents AI Usage API",
    "version": "4.15.8"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "AI Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get AI usage summary for the authenticated user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dashboard.quantcdn.io/api/v3/organizations/:organisation/ai/usage/me",
            "params": [
              {
                "name": "organisation",
                "value": "",
                "type": "path",
                "description": "The organisation ID"
              }
            ]
          },
          "docs": "Get AI usage summary for the authenticated user"
        }
      ]
    }
  ],
  "bundled": true
}